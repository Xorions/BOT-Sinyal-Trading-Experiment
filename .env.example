# Dapatkan token dari @BotFather di Telegram, lalu isi di file .env (bukan di sini)
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan (bisa pakai @userinfobot untuk mengecek ID kamu)
TELEGRAM_CHAT_ID=

# Mode 24/7: sinyal dikirim ke chat PRIVATE, hasil evaluasi ke group PUBLIK.
# Bila kosong, keduanya fallback ke TELEGRAM_CHAT_ID di atas.
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_EVAL_CHAT_ID=

# Opsional: Chat ID admin untuk laporan PRIVATE eksekusi order Bybit.
# Bila kosong, laporan eksekusi TIDAK dikirim (sinyal harian tetap jalan).
TELEGRAM_ADMIN_CHAT_ID=

# Opsional: free API key CoinGecko (https://www.coingecko.com/en/api).
# Tanpa key masih jalan tapi lambat karena kuota publik kecil.
COINGECKO_API_KEY=

# --- Visualisasi Chart TradingView (OPSIONAL) ---
# API key dari https://chart-img.com (plan gratis: 50 gambar/hari) untuk
# notifikasi sinyal dengan gambar chart TradingView + level Entry/SL/TP1/TP2
# tergambar. Tanpa key, bot tetap mengirim sinyal berupa teks biasa.
CHART_IMG_API_KEY=

# --- Automated Trading Bybit Futures (OPSIONAL, default NONAKTIF) ---
# Cara membuat API key (Bybit API v5, tanpa passphrase):
#   1. Login https://www.bybit.com -> Akun -> API Management
#   2. Klik "Create New Key", pilih Unified Trading Account / trading API
#   3. Aktifkan izin "Order" (trade) saja (jangan beri "Withdraw")
#   4. Catat API Key dan Secret Key ke file .env
# Jangan pernah bagikan secret key ke siapa pun.
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
# Sakelar utama autotrade. true = eksekusi order NYATA di Bybit Futures
# (USDT Perpetual, defaultType linear). SELALU mulai dengan false sampai setup teruji.
ENABLE_BYBIT_AUTOTRADE=false
# Risiko per trade dalam persen dari free balance USDT (default 1.0%)
RISK_PERCENT_PER_TRADE=1.0

# Opsional: jumlah koin teratas yang dipindai (maks 250)
TOP_COINS=250

# Jumlah sinyal terbaik yang dipertimbangkan mesin (dari sini bot memilih
# HANYA 1 koin terbaik untuk dikirim)
TOP_SIGNALS=3

# --- Mode 24/7 (scan non-stop) ---
# Jalankan dengan: venv\Scripts\python.exe bot.py --loop
# Interval antar scan (menit). 30 = scan tiap 30 menit sepanjang hari.
SCAN_INTERVAL_MINUTES=30
# Hanya kirim sinyal bila confidence koin terbaik >= nilai ini (persen).
SIGNAL_MIN_CONFIDENCE=65
# Jeda minimum sebelum koin yang sama (symbol + arah) disinyalkan lagi (jam).
SIGNAL_COOLDOWN_HOURS=6
# Umur minimum sinyal tersimpan sebelum dievaluasi & dikirim ke group publik (jam).
EVAL_MIN_AGE_HOURS=4
# Batas umur sinyal yang masih dievaluasi (jam). Lebih tua = dilewati.
EVAL_LOOKBACK_HOURS=24
# Batas umur (hari) entri sesi PAGI/MALAM legacy yang masih dievaluasi;
# lebih tua / sudah final = tidak ditampilkan ulang.
SESSION_EVAL_MAX_AGE_DAYS=3

# Opsional: ambang skor sinyal (default 3.0 untuk BUY, -3.0 untuk SELL)
BUY_THRESHOLD=3.0
SELL_THRESHOLD=-3.0

# --- Day Trading Lanjutan (Analisis Multi-Timeframe) ---
# Jumlah kandidat yang dianalisis mendalam (2 panggilan chart per koin).
# Semakin besar semakin akurat tapi cepat menghabiskan kuota API.
MTF_SCAN_LIMIT=6
# Minimal kategori Confluence yang harus selaras agar sinyal dipromosikan ke BUY/SELL.
CONFLUENCE_MIN=2
# Minimal cek selaras WAJIB dari kategori inti (S&D/S&R + MACD/RSI) agar BUY/SELL valid.
# 0 = nonaktif. Mencegah sinyal bermodal SMC/OB saja lolos.
REQUIRE_CONFLUENCE_CORE=1
# SL/TP berbasis ATR pada timeframe 1H.
ATR_SL_MULT=2.0
ATR_TP1_MULT=2.0
ATR_TP2_MULT=3.0
# SL dinamis di luar swing low/high terdekat: buffer (dalam ATR) & lebar maksimal (dalam ATR).
SWING_SL_BUFFER_MULT=0.5
MAX_SL_MULT=2.5
# Ambang deteksi Whale Spike (volume 1H vs rata-rata 20 bar sebelumnya).
WHALE_VOLUME_MULT=2.5
